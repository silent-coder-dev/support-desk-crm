# Copy this file to .env and fill in real values. Never commit .env. The app reads .env by itself when run locally.
# For Docker, use: docker run --env-file .env ...
# On Render, add the same names under Environment.

# --- Required ---
DB_URL=jdbc:mysql://localhost:3306/crm_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Password for the first "admin" login. Also replaces the old admin123 password on an existing database.
ADMIN_PASSWORD=choose_a_long_unique_password

# Public address of the app. Used for the links inside customer emails.
APP_BASE_URL=https://your-app.onrender.com

# --- Email through Brevo (without these the app runs, but sends no emails) ---
# API key: Brevo > SMTP & API > API Keys. The sender email must be verified in Brevo > Senders.
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM_EMAIL=you@example.com
MAIL_FROM_NAME=SupportDesk

# --- Avatar uploads (without these, photo upload shows an error) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional ---
# Admins add staff from the Staff page, so this can stay false.
# true lets ANYONE register as an agent and read all customer tickets. Only for a public demo.
APP_SIGNUP_ENABLED=false
ADMIN_EMAIL=admin@supportcrm.com
# Hibernate schema mode. "update" adds missing tables and columns at startup.
JPA_DDL_AUTO=update
